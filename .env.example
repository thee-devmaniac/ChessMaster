# Copy this file to .env.local for your own computer, or set these in
# Vercel: Project → Settings → Environment Variables. Never put secrets in
# NEXT_PUBLIC_ variables: they are visible to every visitor.

# Your Google Form's link (use the form's "Send" → link option). Leave empty to hide the feedback link.
NEXT_PUBLIC_FEEDBACK_URL=

# Optional: a link to this app's source code, shown on the About page.
NEXT_PUBLIC_SOURCE_URL=
